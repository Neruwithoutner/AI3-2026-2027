# Copiar para .env e preencher. O .env não entra no repositório.

# Segredo de assinatura dos tokens (HS256): pelo menos 32 caracteres aleatórios.
# Gerar, por exemplo, com:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SEGREDO=

# Validade dos tokens, em segundos (900 por omissão).
JWT_VALIDADE=900
