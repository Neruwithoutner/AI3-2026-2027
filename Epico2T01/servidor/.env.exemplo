# Copiar para .env e preencher. O .env não entra no repositório.

# Porto onde o servidor escuta (3000 por omissão).
PORTO=3000

# Token esperado no cabeçalho X-Admin-Token de PATCH /v1/admin/ocorrencias/{id}.
# Gerar, por exemplo, com:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# --- Ensaios. Deixar vazio em funcionamento normal. ---

# 1: na primeira vez que cada Idempotency-Key é processada com sucesso, o servidor executa a
# operação e fecha a ligação com req.socket.destroy(), sem enviar resposta.
SIMULAR_PERDA_RESPOSTA=

# n: os próximos n pedidos POST recebem 503 com Retry-After: 2, sem efeitos.
SIMULAR_503=
