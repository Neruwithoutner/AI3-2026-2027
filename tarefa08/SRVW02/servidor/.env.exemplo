# Copiar para .env e preencher. O .env não entra no repositório.

# Segredo de assinatura dos tokens (HS256): pelo menos 32 caracteres aleatórios.
# Gerar, por exemplo, com:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SEGREDO=

# Validade dos tokens, em segundos (900 por omissão).
JWT_VALIDADE=900

# --- Ensaios (ficha API05). Deixar vazio em funcionamento normal. ---

# 1: na primeira vez que cada Idempotency-Key é processada com sucesso, o servidor cria a
# sugestão, guarda a chave e fecha a ligação sem enviar resposta (resposta perdida).
SIMULAR_PERDA_RESPOSTA=

# n: os próximos n pedidos POST /v2/sugestoes recebem 503 com Retry-After: 2, sem criar nada.
SIMULAR_503=
